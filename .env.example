# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# --- WhatsApp Cloud API (Meta, free test number) ---
WHATSAPP_TOKEN=            # temporary access token from Meta dashboard
WHATSAPP_PHONE_NUMBER_ID=  # phone number ID of the Meta test number
WHATSAPP_VERIFY_TOKEN=nbfc-demo-verify   # any string; must match what you type in Meta webhook setup
WHATSAPP_APP_SECRET=       # App Secret (Meta app settings > Basic); used to verify webhook signatures

# --- Demo phone numbers (country code + number, no +). Use YOUR test phones. ---
DEMO_CUSTOMER_PHONE=919000000001
DEMO_COLLECTION_PHONE=919000000002
DEMO_MANAGER_PHONE=919000000003

# --- AI model (added on Day 2). Free option: Google Gemini API key from aistudio.google.com ---
GEMINI_API_KEY=

# --- App ---
DB_PATH=nbfc_demo.db
